  <h2 style="color:#1e3a8a;font-size:15pt;">2. SQLite Database Schema (<code>backend/db/database.py</code>)</h2>
  <ul>
    <li><strong><code>users</code></strong>: <code>id</code> (PK), <code>name</code>, <code>mobile</code> (UNIQUE), <code>email</code>, <code>password_hash</code>, <code>has_pmjay</code>, <code>pmjay_card_number</code>, <code>created_at</code>.</li>
    <li><strong><code>user_sessions</code></strong>: <code>token_hash</code> (PK), <code>user_id</code> (FK), <code>expires_at</code>, <code>created_at</code>.</li>
    <li><strong><code>login_attempts</code></strong>: <code>mobile</code> (PK), <code>failure_count</code>, <code>window_started_at</code>, <code>locked_until</code>.</li>
    <li><strong><code>desk_staff</code></strong>: <code>staff_id</code> (PK), <code>hospital_id</code>, <code>token_hash</code> (UNIQUE), <code>active</code>, <code>created_at</code>.</li>
    <li><strong><code>bed_requests</code></strong>: <code>id</code> (PK), <code>user_id</code> (FK), <code>hospital_id</code>, <code>flow_type</code>, <code>specialty</code>, <code>bed_type</code>, <code>bed_unit_id</code>, <code>doctor_incharge</code>, <code>desk_location</code>, <code>patient_count</code>, <code>patient_name</code>, <code>contact_mobile</code>, <code>age</code>, <code>gender</code>, <code>pmjay_card_number</code>, <code>referral_notes</code>, <code>otp_code</code>, <code>otp_expires_at</code>, <code>otp_attempts</code>, <code>hold_expires_at</code>, <code>status</code>, <code>hospital_desk_contact</code>, <code>created_at</code>.</li>
    <li><strong><code>bed_request_events</code></strong>: <code>id</code> (PK), <code>request_id</code> (FK), <code>from_status</code>, <code>to_status</code>, <code>actor_type</code>, <code>actor_id</code>, <code>created_at</code>.</li>
  </ul>
</body>
</html>
